<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>Scratchスタジオメンバー確認</title>
  <style>
    body { font-family: sans-serif; background: #f2f8ff; color: #333; padding: 20px; }
    .container { max-width: 600px; margin: 0 auto; background: #fff; padding: 20px; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
    h1 { font-size: 20px; color: #4d97ff; text-align: center; }
    .input-group { display: flex; gap: 10px; margin-bottom: 20px; }
    input { flex: 1; padding: 10px; border: 2px solid #ccc; border-radius: 6px; font-size: 16px; }
    button { padding: 10px 20px; background: #4d97ff; color: white; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; }
    button:hover { background: #337acc; }
    .member { display: flex; align-items: center; padding: 10px 0; border-bottom: 1px solid #eee; }
    .member img { border-radius: 4px; margin-right: 12px; }
    .member a { color: #4d97ff; text-decoration: none; font-weight: bold; }
    .role { margin-left: auto; font-size: 12px; color: #888; background: #f0f0f0; padding: 3px 8px; border-radius: 12px; }
  </style>
</head>
<body>

  <div class="container">
    <h1>スタジオメンバー自動取得ツール</h1>
    <div class="input-group">
      <input type="text" id="studio-id" placeholder="スタジオIDを入力 (例: 34567890)">
      <button onclick="fetchMembers()">取得する</button>
    </div>
    <div id="result">ここにメンバーが表示されます</div>
  </div>

  <script>
    async function fetchMembers() {
      const s = document.getElementById('studio-id').value.trim();
      const resultDiv = document.getElementById('result');
      
      if (!s) {
        alert('スタジオIDを入力してください');
        return;
      }
      
      resultDiv.innerHTML = "<p style='text-align:center;'><b>読み込み中... 少し待ってね</b></p>";

      try {
        const f = async t => {
          let r = [], o = 0;
          while (true) {
            const res = await fetch(`https://api.scratch.mit.edu/studios/${s}/${t}?limit=40&offset=${o}`);
            const data = await res.json();
            if (!Array.isArray(data) || data.length === 0) break;
            r.push(...data);
            if (data.length < 40) break;
            o += 40;
          }
          return r;
        };

        const [managers, curators] = await Promise.all([f("managers"), f("curators")]);
        const allUsers = [
          ...managers.map(u => ({ ...u, role: "マネージャー" })),
          ...curators.map(u => ({ ...u, role: "キュレーター" }))
        ];

        let html = `<h3 style="text-align:center;">合計: ${allUsers.length} 人<br><span style="font-size:14px; color:#666;">(マネージャー: ${managers.length} / キュレーター: ${curators.length})</span></h3>`;
        
        allUsers.forEach(u => {
          html += `
            <div class="member">
              <img src="https://cdn2.scratch.mit.edu/get_image/user/${u.id}_32x32.png" width="32" height="32">
              <a href="https://scratch.mit.edu/users/${u.username}" target="_blank">${u.username}</a>
              <span class="role">${u.role}</span>
            </div>`;
        });

        resultDiv.innerHTML = html;
      } catch (err) {
        resultDiv.innerHTML = "<p style='color:red; text-align:center;'><b>エラーが発生しました。IDが正しいか確認してください。</b></p>";
      }
    }
  </script>
</body>
</html>
